<resources>
    <color name="widget_background">#101514</color>
    <color name="widget_border">#4B5A52</color>
    <color name="widget_divider">#37433E</color>
    <color name="widget_button_background">#191F1D</color>
    <color name="widget_text">#DFE4E1</color>
    <color name="widget_muted">#AEB7B2</color>
    <color name="widget_green">#A2CDB4</color>
    <color name="widget_pressed">#32DFE4E1</color>

    <style name="Theme.Phantom.WidgetAction" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="PhantomWidgetText">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="PhantomWidgetCaption" parent="PhantomWidgetText">
        <item name="android:textSize">11sp</item>
    </style>

    <style name="PhantomWidgetCompactText" parent="PhantomWidgetText">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="PhantomWidgetButton" parent="PhantomWidgetText">
        <item name="android:background">@drawable/widget_button</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:paddingVertical">0dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>
</resources>
